clc;
clear all;
close all;

% Given Data
Vpp = 4;           % Peak-to-peak voltage
fm = 3.5e3;        % Message frequency
Rb = 50e3;         % Transmission bit rate

% Sampling frequency for DM
fs = Rb;

% Step size
delta = Vpp/16;

% Time axis
t = 0:1/(100*fm):2/fm;

% Message signal
m = (Vpp/2)*sin(2*pi*fm*t);

% Sampling instants
ts = 0:1/fs:2/fm;
ms = (Vpp/2)*sin(2*pi*fm*ts);

% Delta Modulation
dm = zeros(size(ms));
encoded = zeros(size(ms));

for i = 2:length(ms)

    if ms(i) > dm(i-1)
        dm(i) = dm(i-1) + delta;
        encoded(i) = 1;
    else
        dm(i) = dm(i-1) - delta;
        encoded(i) = 0;
    end

end

% Noise calculation
noise = ms - dm;
signal_power = mean(ms.^2);
noise_power = mean(noise.^2);

% SNR calculation
SNR = 10*log10(signal_power/noise_power);

% Display results
fprintf('Sampling Frequency = %.2f Hz\n', fs);
fprintf('Step Size Delta = %.4f V\n', delta);
fprintf('Signal to Noise Ratio = %.2f dB\n', SNR);

% -------------------------------------------------
% Plotting
% -------------------------------------------------
figure;

subplot(3,1,1);
plot(t,m,'b','LineWidth',1.5);
title('Original Message Signal');
xlabel('Time');
ylabel('Amplitude');
grid on;

subplot(3,1,2);
stairs(ts,dm,'r','LineWidth',1.5);
title('Delta Modulated Signal');
xlabel('Time');
ylabel('Amplitude');
grid on;

subplot(3,1,3);
stairs(ts,encoded,'k','LineWidth',1.5);
title('DM Output Bits');
xlabel('Time');
ylabel('Binary Output');
ylim([-0.2 1.2]);
grid on;
